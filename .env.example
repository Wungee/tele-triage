# Copy to .env and fill in. Never commit .env.

# Optional: plain-English summaries via Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: audit log in TimescaleDB instead of SQLite.
#   a) local container:  docker compose --profile timescale up   with
#      DATABASE_URL=postgresql://alarms:change-me@timescaledb:5432/alarms
#   b) Tiger Cloud (managed TimescaleDB): paste the service connection string here
DATABASE_URL=
TIMESCALE_PASSWORD=change-me

# Production: your domain (A record -> server IP). Leave as :80 to serve plain HTTP on the IP.
DOMAIN=:80

# Dev only: where the React dev server runs
CORS_ORIGINS=http://localhost:5173
